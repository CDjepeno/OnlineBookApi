#!/usr/bin/env bash
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running pre-push hook..."

cd apps/nest || exit 1

# Supprimer dist pour éviter les problèmes de permissions venant de Docker
rm -rf dist

# Lancer le build NestJS
if ! npm run build; then
  echo "❌ Build failed, push aborted."
  exit 1
fi

cd ../../
echo "✅ Pre-push hook finished successfully."
