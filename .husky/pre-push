#!/usr/bin/env bash
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running pre-push hook..."

cd apps/nest || exit 1

if ! npm run build; then
  echo "❌ Build failed, push aborted."
  exit 1
fi

cd ../../
echo "✅ Pre-push hook finished successfully."
