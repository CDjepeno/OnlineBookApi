#!/usr/bin/env bash
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running pre-push hook..."

# --- Vérif NestJS ---
cd apps/nest || exit 1
rm -rf dist

echo "📦 Building NestJS..."
if ! npm run build; then
  echo "❌ NestJS build failed, push aborted."
  exit 1
fi

cd ../../

# --- Vérif React ---
cd apps/client-react || exit 1
rm -rf dist

echo "🖥️ Building React..."
if ! npm run build; then
  echo "❌ React build failed, push aborted."
  exit 1
fi

cd ../../

echo "✅ Pre-push hook finished successfully."

